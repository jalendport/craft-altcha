{% set plugin = craft.app.plugins.getPlugin('altcha') %}
{% set settings = plugin ? plugin.settings : null %}

{# /lab-test is the only route the lab registers, so the integration pages hang
   off it as ?page=… includes rendered from this same template root. #}
{% set pages = {
	'formie': 'Formie',
	'comments': 'Comments',
	'contact-form': 'Contact Form',
	'users': 'Users',
	'guest-entries': 'Guest Entries',
	'blanket': 'Blanket mode',
} %}
{% set page = craft.app.request.getQueryParam('page') %}
{% set page = page in pages|keys ? page : null %}

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8">
		<title>Altcha smoke test{{ page ? ' — ' ~ pages[page] }}</title>
		<style>
			body { font-family: system-ui, sans-serif; margin: 2rem auto; max-width: 52rem; padding: 0 1rem; }
			nav a { margin-right: 1rem; }
			form { border: 1px solid #ccc; padding: 1rem; margin: 1rem 0; }
			fieldset { border: none; padding: 0; margin: 0 0 .75rem; }
			label { display: block; margin: .5rem 0 .25rem; }
			.flash-notice { background: #e6f6e6; border: 1px solid #4a4; padding: .5rem 1rem; }
			.flash-error { background: #fbeaea; border: 1px solid #c44; padding: .5rem 1rem; }
			.errors { color: #c00; }
			.hint { color: #555; font-size: .9rem; }
			table { border-collapse: collapse; }
			th, td { border: 1px solid #ccc; padding: .4rem .6rem; text-align: left; }
			code { background: #f4f4f4; padding: .1rem .3rem; }
			pre { background: #f4f4f4; padding: .75rem; overflow-x: auto; }
		</style>
	</head>
	<body>
		<h1>Altcha smoke test</h1>

		<nav>
			<a href="{{ url('lab-test') }}">Index</a>
			{% for handle, label in pages %}
				<a href="{{ url('lab-test', { page: handle }) }}"{% if page == handle %} aria-current="page"{% endif %}>{{ label }}</a>
			{% endfor %}
		</nav>

		{# Craft's controllers flash their outcomes; surface them on every page so
		   each form's redirect-back lands somewhere that says what happened. Keys
		   and shapes vary by controller, so take everything and normalize. #}
		{% for type, flashes in craft.app.session.getAllFlashes(true) %}
			{% for flash in flashes is iterable ? flashes : [flashes] %}
				{% set message = flash.message is defined ? flash.message : flash %}
				<p class="{{ 'error' in type ? 'flash-error' : 'flash-notice' }}">{{ message is iterable ? message|json_encode : message }}</p>
			{% endfor %}
		{% endfor %}

		{% if page %}
			{% include "_lab_test/pages/#{page}" %}
		{% else %}
			{% include '_lab_test/pages/index' %}
		{% endif %}
	</body>
</html>
