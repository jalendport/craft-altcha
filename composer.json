{
  "name": "jalendport/craft-altcha",
  "description": "Integrate Altcha's privacy-first spam protection into your Craft CMS forms.",
  "type": "craft-plugin",
  "license": "mit",
  "keywords": [
    "craft",
    "cms",
    "craftcms",
    "craft-plugin",
    "altcha",
    "captcha",
    "spam",
    "anti-spam"
  ],
  "authors": [
    {
      "name": "Jalen Davenport",
      "homepage": "https://jalendport.com"
    }
  ],
  "support": {
    "email": "hello@jalendport.com",
    "issues": "https://github.com/jalendport/craft-altcha/issues",
    "source": "https://github.com/jalendport/craft-altcha",
    "docs": "https://github.com/jalendport/craft-altcha/blob/master/README.md"
  },
  "require": {
    "php": "^8.2",
    "craftcms/cms": "^5.0.0",
    "jalendport/craft-base": "^1.1",
    "altcha-org/altcha": "^2.0"
  },
  "require-dev": {
    "craftcms/contact-form": "^3.0",
    "craftcms/ecs": "dev-main",
    "craftcms/guest-entries": "^4.0",
    "craftcms/phpstan": "dev-main",
    "craftcms/rector": "dev-main",
    "pestphp/pest": "^3.0",
    "verbb/comments": "^3.0",
    "verbb/formie": "^3.0"
  },
  "autoload": {
    "psr-4": {
      "jalendport\\altcha\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "jalendport\\altcha\\tests\\": "tests/"
    }
  },
  "extra": {
    "name": "Altcha",
    "handle": "altcha",
    "class": "jalendport\\altcha\\Altcha",
    "documentationUrl": "https://github.com/jalendport/craft-altcha/blob/master/README.md",
    "changelogUrl": "https://raw.githubusercontent.com/jalendport/craft-altcha/master/CHANGELOG.md"
  },
  "scripts": {
    "check-cs": "ecs check --ansi",
    "fix-cs": "ecs check --ansi --fix",
    "phpstan": "phpstan --memory-limit=1G",
    "test": "pest"
  },
  "config": {
    "sort-packages": true,
    "platform": {
      "php": "8.2"
    },
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "yiisoft/yii2-composer": true,
      "craftcms/plugin-installer": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
