{# @var plugin \jalendport\altcha\Altcha #}
{# @var settings \jalendport\altcha\models\Settings #}

{% extends 'altcha/_settings/_layout' %}

{% import '_includes/forms.twig' as forms %}
{% import 'jalendport-base/_macros' as base %}

{% block settingsHtml %}

	{{ forms.autosuggestField({
		first: true,
		label: 'HMAC key'|t('altcha'),
		instructions: 'The secret key used to sign and verify challenges. Run `php craft altcha/generate-hmac-key` to generate one.'|t('altcha'),
		suggestEnvVars: true,
		name: 'hmacKey',
		value: settings.hmacKey,
		required: true,
		disabled: readOnly or 'hmacKey' in overrides,
		errors: settings.getErrors('hmacKey'),
		warning: base.configWarning('hmacKey', 'altcha'),
	}) }}

	{{ forms.selectField({
		label: 'Complexity'|t('altcha'),
		instructions: 'How much work a visitor’s browser spends solving a challenge. Higher settings cost bots more, but also slow real visitors down on older devices.'|t('altcha'),
		id: 'complexity',
		name: 'complexity',
		options: [
			{ label: 'Low'|t('altcha'), value: 1000 },
			{ label: 'Medium'|t('altcha'), value: 50000 },
			{ label: 'High'|t('altcha'), value: 100000 },
		],
		value: settings.complexity,
		disabled: readOnly or 'complexity' in overrides,
		errors: settings.getErrors('complexity'),
		warning: base.configWarning('complexity', 'altcha'),
	}) }}

	{{ forms.textField({
		type: 'number',
		label: 'Challenge expiry'|t('altcha'),
		instructions: 'How long an issued challenge stays valid. Anything from 20 to 60 minutes suits most forms.'|t('altcha'),
		id: 'challengeExpiryMinutes',
		name: 'challengeExpiryMinutes',
		value: settings.challengeExpiryMinutes,
		size: 5,
		min: 1,
		max: 1440,
		step: 1,
		suffix: 'minutes'|t('altcha'),
		disabled: readOnly or 'challengeExpiryMinutes' in overrides,
		errors: settings.getErrors('challengeExpiryMinutes'),
		warning: base.configWarning('challengeExpiryMinutes', 'altcha'),
	}) }}

{% endblock %}
